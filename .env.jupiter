# Jupiter-only launcher build.
#
# Vite loads this file on top of .env when `--mode jupiter` is passed, so
# any Supabase vars in .env still apply — only the launcher changes.
# Enable with one of:
#   npm run dev:jupiter        (browser preview: http://localhost:5173)
#   npm run build:jupiter      (frontend build into dist/)
#   npm run tauri:dev:jupiter  (desktop dev window)
#   npm run tauri:build:jupiter(desktop installer)
#
# When set, the launcher main menu renders ONLY the Warzone III (Jupiter)
# tile, filling the entire screen — no IW8 option. The normal npm run dev /
# npm run build (no mode) keep the two-tile launcher.
VITE_JUPITER_ONLY=true
