{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Legacy Warzone Launcher",
  "version": "1.7.2",
  "identifier": "com.beanstalk313.legacy-warzone-launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Legacy Warzone Launcher",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": true,
        "decorations": false,
        "center": true,
        "minWidth": 1024,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../RTM.exe": "RTM.exe"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFNjlENkI0NjlBRTcwNzQKUldSMGNLNXB0TlpwbmlUZUhDNUZ2N0FSRFhaR2U5eVdFdEF3bnIxS3I0M3p0R1cxWmRrQzI0QjAK",
      "endpoints": [
        "https://github.com/Beanstalk0313/Legacy-Warzone-Launcher/releases/latest/download/latest.json"
      ]
    }
  }
}
